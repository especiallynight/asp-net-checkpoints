@page
@model Checkpoint_19.Chat.ChatPageModel
@{
}


<h2>Чат</h2>

<div class="mb-3">
    <p>Вы вошли как: <strong id="currentUser">@Model.Username</strong></p>
    <button id="logoutButton" class="btn btn-sm btn-outline-danger">Выйти</button>
</div>

<div id="messagesList" class="border p-3 mb-3" style="height: 300px; overflow-y: auto;"></div>

<input type="text" id="messageInput" placeholder="Ваше сообщение" class="form-control mb-2" />
<button id="sendButton" class="btn btn-primary">Отправить</button>

<div id="status" style="margin-top: 10px;"></div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
            return null;
        }
        const token = getCookie("jwt_token");
        console.log("Token:", token ? token.substring(0, 20) + "..." : "not found");

        if (!token) {
            alert("Токен не найден. Необходимо войти в систему.");
            window.location.href = "/Account/Login";
            throw new Error("JWT token not found");
        }

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chathub", {
                accessTokenFactory: () => token
            })
            .withAutomaticReconnect()
            .build();

        const currentUser = "@User.Identity?.Name";

        connection.on("ReceiveMessage", function (user, message) {
            const msg = document.createElement("div");
            msg.innerHTML = `<strong>${escapeHtml(user)}</strong>: ${escapeHtml(message)}`;
            document.getElementById("messagesList").appendChild(msg);
            document.getElementById("messagesList").scrollTop = 
                document.getElementById("messagesList").scrollHeight;
        });

        document.getElementById("sendButton").addEventListener("click", function () {
            const message = document.getElementById("messageInput").value;
            if (message.trim()) {
                connection.invoke("SendMessage", message)
                    .then(() => {
                        document.getElementById("messageInput").value = '';
                    })
                    .catch(err => {
                        console.error("Send error:", err);
                        showStatus("Ошибка отправки: " + err.message, "danger");
                    });
            }
        });

        document.getElementById("messageInput").addEventListener("keypress", function (e) {
            if (e.key === "Enter") {
                document.getElementById("sendButton").click();
            }
        });

        connection.start()
            .then(() => {
                console.log("Connected to chat with JWT");
                showStatus("Подключено к чату", "success");
            })
            .catch(err => {
                console.error("Connection error:", err);
                if (err.message.includes("401")) {
                    showStatus("Ошибка авторизации. Перенаправление на вход...", "danger");
                    setTimeout(() => {
                        document.cookie = "jwt_token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
                        window.location.href = "/Account/Login";
                    }, 2000);
                } else {
                    showStatus("Ошибка подключения: " + err.message, "danger");
                }
            });

        document.getElementById("logoutButton").addEventListener("click", function() {
            if (connection.state === signalR.HubConnectionState.Connected) {
                connection.stop();
            }
            document.cookie = "jwt_token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
            window.location.href = "/Account/Logout";
        });
        function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
        }

        function showStatus(message, type) {
        const statusDiv = document.getElementById("status");
        statusDiv.className = `alert alert-${type}`;
        statusDiv.innerText = message;
        }
    </script>
}